# NexusDock 站点 env 示例：仓库 docker-compose.yml 是唯一结构源，站点差异只写在这里。
# 本地使用：cp .env.example .env；生产使用：复制到生产目录（如 nexusdock.env，chmod 600），
# 部署命令形如 docker compose -f <仓库>/docker-compose.yml --env-file <站点文件> ...，
# 完整步骤见 docs/deploy.zh-CN.md。

# 宿主机数据目录（挂载到容器 /var/lib/nexus），生产建议绝对路径。
NEXUS_DATA_DIR=./nexus-data

# 共享 Recall 仓库目录（挂载到容器 /recall），生产建议绝对路径。
RECALL_REPO_DIR=./recall

# 对外 HTTPS Origin（本机反向代理之后对公网暴露的地址）；留空表示仅本机回环访问。
NEXUS_PUBLIC_URL=

# 允许提供可信 X-Forwarded-* 的代理地址/网段。
# 默认只信任本机回环；生产按真实反代来源收敛，例如反代与 NexusDock 同处
# 192.168.227.0/24 Docker 网络时用 127.0.0.1,::1,192.168.227.0/24，
# 不要放行整个 RFC1918 私网（10/8、172.16/12、192.168/16）。
NEXUS_TRUSTED_PROXIES=127.0.0.1,::1

# 宿主机监听地址与端口（容器内固定 18777）。默认只绑定回环，由本机反向代理对外；
# 若反代是同 Docker 网络中的容器，改为 0.0.0.0 并用防火墙限制来源。
NEXUS_HTTP_BIND=127.0.0.1
NEXUS_HTTP_PORT=18777

# 生产部署固定使用的镜像标签。留空回退 nexusdock:local（本地构建场景）。
# 生产建议固定 sha-<短SHA> 标签（发布流水线产物，与部署提交一一对应），
# 不要用 latest 部署生产，详见 docs/deploy.zh-CN.md。
NEXUS_IMAGE=

# 本地 docker compose build 注入的版本信息（缺省与 Dockerfile/Makefile 一致）；
# 生产直接消费发布镜像，不参与构建，无需设置。
#NEXUS_VERSION=dev
#NEXUS_REVISION=unknown
#NEXUS_SOURCE=unknown
